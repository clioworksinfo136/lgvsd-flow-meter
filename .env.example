# Copy to .env.local (or .env) and fill in. Both files are gitignored.

# Google Maps JavaScript API key — required, the map will not render without it.
# Enable "Maps JavaScript API" and restrict the key to your domains.
VITE_GOOGLE_MAPS_API_KEY=

# Map ID. AdvancedMarker requires one; DEMO_MAP_ID works for local development
# but shows a watermark. Create your own in the Google Cloud console for production.
VITE_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID

# Mapbox public access token (starts with pk.) — required to fetch vector tiles.
VITE_MAPBOX_ACCESS_TOKEN=

# Mapbox vector tileset holding the gravity sewer network.
VITE_MAPBOX_TILESET_ID=hazensawyer.9wms9cz6

# Source layer(s) within the tileset to draw as gravity pipes (comma-separated).
# Leave blank to render every source layer; set this once you know the real
# layer name from Mapbox Studio, so unrelated layers are not drawn as pipes.
VITE_GRAVITY_PIPE_SOURCE_LAYERS=
